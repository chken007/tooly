{
  "name": "tooly",
  "version": "1.0.0",
  "description": "Simple tools for everyday coding - A collection of essential developer utilities",
  "private": false,
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "diff": "^9.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "preview": "vite preview",
    "deploy": "npm run build && vercel --prod"
  },
  "keywords": [
    "developer-tools",
    "base64",
    "jwt",
    "diff",
    "time-converter",
    "list-processing",
    "react",
    "typescript",
    "utilities"
  ],
